{
    "name": "osoobe/laravel-traits",
    "description": "A collection of reusable Laravel Eloquent model traits.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "traits",
        "eloquent",
        "models"
    ],
    "authors": [
        {
            "name": "Oshane Bailey",
            "email": "b4.oshany@gmail.com"
        }
    ],
    "require": {
        "illuminate/support": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0",
        "osoobe/laravel-utilities": "*"
    },
    "autoload": {
        "psr-4": {
            "Osoobe\\LaravelTraits\\": "./src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Osoobe\\LaravelTraits\\Tests\\": "tests/",
            "App\\": "tests/Stubs/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Osoobe\\LaravelTraits\\LaravelTraitsServiceProvider"
            ]
        }
    },
    "require-dev": {
        "orchestra/testbench": "^6.0|^7.0|^8.0|^9.0|^10.0"
    }
}
